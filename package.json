{
  "name": "ze-great-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A team-visible trust dashboard: a lens on your engineering state, not a ledger of it.",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/server",
    "packages/client",
    "packages/aws"
  ],
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test && node scripts/test-docker-image.mjs && node packages/core/dist/cli.js validate --board-config boards/example.yaml && npm run test:published",
    "verify": "npm run check && npm run build && npm run build:lambda --workspace @ze-great-dashboard/server",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "concurrently -g --kill-others-on-fail -n root,shared,core,server,client,aws \"tsc -p tsconfig.json\" \"tsc -p packages/shared\" \"tsc -p packages/core\" \"tsc -p packages/server\" \"tsc -p packages/client\" \"tsc -p packages/aws\"",
    "test": "npm run test:unit && npm run test:browser:no-build",
    "test:unit": "npm run build:packages && vitest run",
    "test:published": "node scripts/test-published-packages.mjs",
    "update:dependencies": "XDG_CONFIG_HOME=\"${TMPDIR:-/tmp}/npm-check-updates\" ncu --workspaces --root --reject npm --upgrade && npm install --ignore-scripts",
    "test:installed": "node scripts/test-installed-package.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:no-build": "node scripts/test-browser.mjs --no-build",
    "test:watch": "vitest",
    "capture:readme": "node scripts/capture-readme-demo.mjs",
    "capture:readme:states": "node scripts/capture-readme-panel-states.mjs",
    "dev": "concurrently -k -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "ado-entra-token": "node scripts/ado-entra-token.mjs",
    "dev:client": "npm run dev --workspace @continuous-excellence/ze-great-dashboard-client",
    "dev:server": "ASSET_PATH=http://localhost:5173/__ASSET_PATH__ TEMPLATE_WAIT_MS=20000 npm run dev --workspace @ze-great-dashboard/server",
    "build": "npm run build --workspace @continuous-excellence/ze-great-dashboard-client",
    "build:packages": "node scripts/build-packages.mjs",
    "publish:packages": "node scripts/publish-packages.mjs",
    "build:release": "npm run build:packages && node packages/core/dist/cli.js validate --board-config boards/example.yaml",
    "release:version": "bash scripts/release-version.sh",
    "release:provision": "bash scripts/provision-aws.sh",
    "release:deploy": "bash scripts/deploy-aws.sh",
    "release:tag": "bash scripts/tag-release.sh",
    "postinstall": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@continuous-excellence/tagger": "3.6.18",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "npm-check-updates": "23.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
