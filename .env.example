# Copy to `.env` (gitignored) and fill in. This file names every variable and holds no values,
# because the failure mode is a credential in git history, which is not a thing to discover later.
#
# Only `docker compose up` reads `.env`. `npm run dev` sets what it needs in the dev script.

# --- Optional, with sane defaults ---

# Where the built client lives. Released Docker images already default to their matching versioned
# CDN path, so leave this unset for normal `docker compose up`. Set it to intentionally select a
# different client version or to test local assets.
#   alternate release: https://public-assets.zegreatrob.com/dashboard/1.0.7
#   local dev:          http://localhost:5173/__ASSET_PATH__
# ASSET_PATH=

# Published image to run with Docker Compose. `latest` is mutable evaluation convenience: pull it
# explicitly before use. Pin an exact reviewed version for a persistent deployment or rollback.
# Local source builds use docker-compose.local.yml instead.
# DASHBOARD_IMAGE=ghcr.io/robertfmurdock/ze-great-dashboard:latest

# Path the client calls for signal data. Default: /api
PROXY_PATH=

# Where board configuration is read from — a URL or a local file path. Default: ./boards/example.yaml
# Server-only: this never reaches the browser, so it may point somewhere private.
BOARD_CONFIG_URL=

# Which board `GET /` renders. Optional when the selected config contains exactly one board.
BOARD=

# Default: 3000 / localhost. Binding to a non-localhost address with no auth configured logs a
# warning, because at that point the board is visible to anyone who can reach it.
PORT=
HOST=

# How long to retry an unreachable client template at boot, in milliseconds. Default: 0, meaning a
# bad ASSET_PATH fails immediately — which is what you want anywhere but a local dev race.
TEMPLATE_WAIT_MS=

# --- Credentials ---
#
# Board config never contains a credential. It names an environment variable via `token_env:`, and
# the value lives here. When the first adapter lands, its variable gets a line in this file.
#   ADO_TOKEN=
# GitHub fine-grained PAT with read-only Actions access; omit for public repositories.
GITHUB_TOKEN=

# Azure DevOps PAT mode: a Build (read)-scoped PAT, named by `token_env` in the board.
ADO_PAT=

# Experimental local Azure DevOps Entra mode: `npm run ado-entra-token` creates this file. Do not
# put a token here. Docker Compose gets the token through docker-compose.entra.yml instead.
# ADO_ENTRA_TOKEN_FILE=
