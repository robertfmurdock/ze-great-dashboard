{
  "name": "@ze-great-dashboard/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Renders the entrypoint and (from Stage 2) proxies signal data. Holds the credentials; stores nothing.",
  "exports": {
    "./internal/configuration": "./src/packaging.ts"
  },
  "scripts": {
    "dev": "node scripts/watch-server.mjs",
    "start": "tsx src/node-server.ts",
    "build:lambda": "esbuild src/lambda.ts --bundle --minify --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" && cp \"${BOARD_CONFIG_PATH:-../../boards/example.yaml}\" dist/board.yaml"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@hono/node-server": "^2.1.5",
    "@ze-great-dashboard/shared": "*",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
