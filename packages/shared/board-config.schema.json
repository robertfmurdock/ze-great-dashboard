{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-config.schema.json",
  "title": "Ze Great Dashboard board configuration",
  "type": "object",
  "required": ["boards"],
  "additionalProperties": true,
  "properties": {
    "sources": { "type": "object", "additionalProperties": { "$ref": "#/$defs/source" } },
    "boards": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/board" }
    },
    "auth": { "$ref": "#/$defs/auth" }
  },
  "$defs": {
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(?:ms|s|m|h)$" },
    "position": {
      "oneOf": [
        {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "w": { "type": "integer", "minimum": 1, "maximum": 12 },
            "h": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "const": 0 },
            "y": { "const": 0 },
            "w": { "const": 0 },
            "h": { "const": 0 }
          },
          "additionalProperties": true
        }
      ]
    },
    "panel": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "pipeline": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "density": { "enum": ["auto", "comfortable", "compact"] },
        "position": { "$ref": "#/$defs/position" },
        "refresh": { "$ref": "#/$defs/duration" },
        "running_refresh": { "$ref": "#/$defs/duration" },
        "running_completion_refresh": { "$ref": "#/$defs/duration" },
        "running_completion_window": { "$ref": "#/$defs/duration" },
        "running_animation": {
          "enum": [
            "radial",
            "runway",
            "orbit",
            "signal-field",
            "telemetry-bloom",
            "release-transit",
            "status-weather",
            "falling-shapes",
            "off"
          ]
        },
        "demo_run_duration": { "$ref": "#/$defs/duration" },
        "demo_review_duration": { "$ref": "#/$defs/duration" },
        "link": { "type": "string", "format": "uri" },
        "url": { "type": "string", "format": "uri" },
        "json_path": {
          "type": "string",
          "pattern": "^\\$(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[\\d+\\])*$"
        }
      }
    },
    "board": {
      "type": "object",
      "required": ["panels"],
      "additionalProperties": true,
      "properties": {
        "refresh": { "$ref": "#/$defs/duration" },
        "running_refresh": { "$ref": "#/$defs/duration" },
        "running_completion_refresh": { "$ref": "#/$defs/duration" },
        "running_completion_window": { "$ref": "#/$defs/duration" },
        "panels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/panel" } }
      }
    },
    "source": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "token_env": { "type": "string", "minLength": 1 },
        "github_app": {
          "type": "object",
          "required": ["app_id_env", "private_key_env", "installation_id_env"],
          "properties": {
            "app_id_env": { "type": "string", "minLength": 1 },
            "private_key_env": { "type": "string", "minLength": 1 },
            "installation_id_env": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["issuer"],
      "properties": {
        "issuer": { "type": "string", "format": "uri" },
        "client_id": { "type": "string", "minLength": 1 },
        "allow": {
          "type": "object",
          "properties": {
            "groups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "subjects": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
